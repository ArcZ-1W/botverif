const OK=/\.(txt|md|markdown|csv|tsv|json|xml|ya?ml|log|ini|toml|html?|css|jsx?|tsx?|py|java|c|h|cpp|cs|go|rs|php|rb|sh|sql|kt|swift|lua)$/i;
