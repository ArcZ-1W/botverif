bx.addEventListener("drop",e=>{e.preventDefault();bx.classList.remove("drag");addFiles([...e.dataTransfer.files])});

/* jalankan html */
function openRun(code){const m=code.match(/<title>([^<]*)<\/title>/i);$("#rt").textContent=(m&&m[1].trim())||"Pratinjau HTML";$("#rf").srcdoc=code;$("#run").dataset.code=code;$("#run").classList.add("on")}
function closeRun(){$("#run").classList.remove("on");$("#rf").srcdoc=""}
$("#rx").onclick=closeRun;
$("#rTab").onclick=()=>window.open(URL.createObjectURL(new Blob([$("#run").dataset.code],{type:"text/html"})),"_blank");
$("#run").onclick=e=>{if(e.target.id==="run")closeRun()};

/* pengaturan */
const TABS=[["umum","Umum","gear"],["profil","Profil","user"],["data","Data","db"],["tentang","Tentang","info"]];
function renderTab(){
  $("#tabs").innerHTML=TABS.map(t=>`<button data-t="${t[0]}" class="${t[0]===tab?"on":""}">${ic(t[2])}${t[1]}</button>`).join("");
  const b=$("#pbody");
  if(tab==="umum")b.innerHTML=`<div class="lbl">Tema</div><div class="themes">`+[["light","Terang","sun"],["dark","Gelap","moon"],["auto","Sistem","mon"]].map(t=>`<button data-th="${t[0]}" class="${theme===t[0]?"on":""}">${ic(t[2])}${t[1]}</button>`).join("")+
    `</div><div class="lbl">Instruksi tambahan untuk Xozen</div><textarea id="sSys" placeholder="Contoh: Jawab singkat dalam bahasa Indonesia.">${esc(cfg.sys)}</textarea><button class="pill" data-d="preset" style="margin-top:8px">Pakai preset File Generator</button><div class="lbl">Gaya jawaban</div><input type="range" id="sTemp" min="0" max="2" step="0.1" value="${cfg.temp}"><div class="rng"><span>Presisi</span><span>Kreatif</span></div><div class="lbl">API key</div><input type="password" id="sKey" placeholder="Kosongkan untuk pakai bawaan file" value="${esc(cfg.key)}">`;
  if(tab==="profil")b.innerHTML=`<div class="lbl">Nama</div><input type="text" id="sName" value="${esc(cfg.name)}" maxlength="30"><p class="mute" style="margin-top:14px">Obrolan tersimpan di browser perangkat ini saja.</p>`;
  if(tab==="data")b.innerHTML=`<div class="row2"><span>Ekspor data</span><button class="pill" data-d="export">Ekspor</button></div><div class="row2"><span>Hapus semua obrolan</span><button class="pill red" data-d="wipe">Hapus semua</button></div>`;
  if(tab==="tentang")b.innerHTML=`<div class="row2"><span>Xozen</span><span class="mute">Asisten AI</span></div><p class="mute" style="margin-top:14px">Dihasilkan AI, hanya untuk referensi.</p>`;
}
function openSet(t){tab=t||"umum";renderTab();$("#modal").classList.add("on");closeSide()}
$("#prof").onclick=()=>openSet("profil");
$("#mx").onclick=()=>$("#modal").classList.remove("on");
$("#modal").onclick=e=>{if(e.target.id==="modal")$("#modal").classList.remove("on")};
$("#tabs").onclick=e=>{const b=e.target.closest("[data-t]");if(b){tab=b.dataset.t;renderTab()}};
$("#pbody").addEventListener("click",e=>{
  const th=e.target.closest("[data-th]"),d=e.target.closest("[data-d]");
  if(th){theme=th.dataset.th;store.set("xz_theme",theme);applyTheme();renderTab()}
  if(d&&d.dataset.d==="preset"){cfg.sys=PRESET;store.set("xz_cfg",cfg);renderTab()}
  if(d&&d.dataset.d==="export"){const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([JSON.stringify(chats,null,2)],{type:"application/json"}));a.download="xozen-obrolan.json";a.click()}
  if(d&&d.dataset.d==="wipe"&&confirm("Hapus semua obrolan? Tindakan ini tidak bisa dibatalkan.")){chats=[];cur=null;save();renderAll();$("#modal").classList.remove("on")}
});
$("#pbody").addEventListener("input",e=>{
  const i=e.target.id;
  if(i==="sSys")cfg.sys=e.target.value;if(i==="sTemp")cfg.temp=+e.target.value;if(i==="sKey")cfg.key=e.target.value.trim();
  if(i==="sName"){cfg.name=e.target.value;renderSide()}
  store.set("xz_cfg",cfg);
});
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeRun();$("#imodal").classList.remove("on");$("#modal").classList.remove("on");$("#menu").classList.remove("on");$("#mpop").classList.remove("on");closeSide()}});

if(!getChat()&&chats.length)cur=chats[chats.length-1].id;
applyTheme();renderAll();
</script>
</body>
</html>
